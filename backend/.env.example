# Copy to backend/.env for local development. Never commit the real .env file.
APP_ENV=development
# Local dev uses SQLite. For Supabase/PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./wispex_dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Must be true in staging/production (HTTPS only)
COOKIE_SECURE=false
# Only needed if the browser calls the API directly instead of through the Next.js proxy
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Fernet key for OAuth tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Google Calendar (optional). Leave empty to disable. Redirect URI goes through the frontend proxy:
# http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

DEMO_MODE_ENABLED=true

# ---------- Document AI (MVP 3) ----------
# Only enable after your organization permits sending documents to this provider.
# Each user must also confirm this in Settings before any document is sent.
#   AI_PROVIDER=anthropic   Claude (vision + structured output)
#   AI_PROVIDER=fake        deterministic stand-in for development/tests (refused in production)
#   AI_PROVIDER=            disabled: documents are stored and fields entered by hand
AI_PROVIDER=
# Anthropic API key. If empty, the SDK reads ANTHROPIC_API_KEY from the environment.
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=120

# ---------- Document storage ----------
# local: files encrypted on disk under STORAGE_DIR (uses ENCRYPTION_KEY)
# supabase: private Supabase Storage bucket (service role key stays on the server)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=50

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# ---------- Knowledge search by meaning ----------
# local: a small embedding model runs on this server (no knowledge text leaves it). off: keywords only.
# The model is downloaded on first use (about 90 MB). For offline servers run
# `python -m app.ai.embeddings download` at build time, or set EMBEDDING_MODEL_PATH to a model folder.
SEMANTIC_SEARCH=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=
EMBEDDING_CACHE_DIR=./models
# 0 = the tested default for the model. Check with your own notes before changing the model.
SEMANTIC_MIN_SIMILARITY=0

# Demo sessions per minute per client address (raise only for automated end-to-end tests)
DEMO_RATE_LIMIT_PER_MINUTE=30
