# Copy to backend/.env for local development. Never commit the real .env file.
APP_ENV=development
# Local dev uses SQLite. For Supabase/PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./wispex_dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Must be true in staging/production (HTTPS only)
COOKIE_SECURE=false
# Only needed if the browser calls the API directly instead of through the Next.js proxy
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Fernet key for OAuth tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Google Calendar (optional). Leave empty to disable. Redirect URI goes through the frontend proxy:
# http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

DEMO_MODE_ENABLED=true

# Later MVP phases (not used yet)
AI_PROVIDER=
AI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
